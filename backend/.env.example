# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-string

# Postgres connection string (works for local Postgres, Neon, or any
# standard postgresql:// URL). Neon connection strings already include
# ?sslmode=require, which is required and handled automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phd_dashboard

# Must exactly match the URL your frontend runs on (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173
